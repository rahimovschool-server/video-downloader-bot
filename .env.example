# ─── MAJBURIY ────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── PYROGRAM (my.telegram.org dan oling) ────────────────
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# STRING_SESSION — utils/session_gen.py ni ishga tushiring
STRING_SESSION=

# ─── STORAGE KANAL ───────────────────────────────────────
# Yopiq kanal yarating, botni admin qiling, ID ni kiriting
# Kanal ID ni olish: @username_to_id_bot ga forwarding qiling
STORAGE_CHANNEL_ID=-1001234567890

# ─── RAILWAY (Avtomatik, qo'lda kiritmang) ───────────────
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
WEBHOOK_SECRET=my-secret-token-12345

# ─── INSTAGRAM (Ixtiyoriy) ───────────────────────────────
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ─── SOZLAMALAR ──────────────────────────────────────────
DOWNLOAD_DIR=downloads
THROTTLE_RATE=5

# Playlist limiti (0 = cheksiz, 10 = faqat birinchi 10 ta)
PLAYLIST_MAX_ITEMS=0
